# Force LF line endings for all text files
* text=auto eol=lf

# Ensure these are always LF (even on Windows)
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.blade.php text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.env text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.sql text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf
