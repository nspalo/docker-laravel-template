#
# Docker Environment Config
#============================
# This is the single control panel for the template.
# Change values here to configure the entire stack.

# SYSTEM VARIABLES
# values: dev | staging | prod
SYS_ENV=dev
COMPOSE_PROJECT_NAME=docker_laravel

# WEBSERVER (Nginx)
APP_PORT=80

# PHP
PHP_VERSION=8.4
PHP_PORT=9000

# NODE
NODE_VERSION=20

# DATABASE (MySQL)
DB_VERSION=8.0
DB_PORT=3306

# PATHS
PATH_CONTAINERS=./containers
PATH_ENVIRONMENTS=./environments

# SOURCE
PATH_SOURCE_LIVE=/var/www/html
PATH_SOURCE_LOCAL=../src
